:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #e7eefb;
  background: #07111d;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  background:
    radial-gradient(circle at top, rgba(59, 130, 246, 0.2), transparent 30%),
    #07111d;
}

body {
  min-height: 100vh;
}

button {
  font: inherit;
}

.app-shell {
  display: flex;
  min-height: 100vh;
  color: #e5edf8;
}

.sidebar {
  width: 290px;
  background: rgba(9, 18, 30, 0.9);
  border-right: 1px solid rgba(148, 163, 184, 0.2);
  padding: 28px 20px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 34px;
}

.logo {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 1.2rem;
  background: linear-gradient(135deg, #4cc9f0, #4361ee);
  color: white;
  box-shadow: 0 12px 24px rgba(67, 97, 238, 0.38);
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.66rem;
  color: #90a9c7;
}

.brand h1,
.topbar h2,
.panel-header h3 {
  margin: 0;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-item {
  border: 1px solid transparent;
  background: rgba(15, 23, 42, 0.8);
  padding: 12px 14px;
  border-radius: 12px;
  color: #dfe9f8;
  text-align: left;
  cursor: pointer;
  transition: all 0.2s ease;
}

.nav-item:hover,
.nav-item.active {
  background: rgba(59, 130, 246, 0.12);
  border-color: rgba(96, 165, 250, 0.35);
}

.sidebar-card {
  background: rgba(17, 24, 39, 0.96);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16px;
  padding: 18px;
  margin-top: 24px;
}

.sidebar-card strong {
  display: block;
  margin: 8px 0 12px;
}

.progress-line {
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.15);
  overflow: hidden;
  margin-bottom: 10px;
}

.progress-line span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #45d4b3, #4cc9f0);
}

.main-panel {
  flex: 1;
  padding: 32px 30px 40px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
}

.actions {
  display: flex;
  gap: 12px;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  border: none;
  border-radius: 12px;
  padding: 11px 16px;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.primary-btn:hover,
.secondary-btn:hover,
.ghost-btn:hover {
  transform: translateY(-1px);
}

.primary-btn {
  background: linear-gradient(135deg, #4cc9f0, #4361ee);
  color: white;
}

.secondary-btn,
.ghost-btn {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  color: #dfeaf8;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
  gap: 18px;
  margin-bottom: 24px;
}

.metric-card {
  padding: 18px 18px 16px;
  border-radius: 18px;
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.14);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.metric-card span {
  color: #bfd0ea;
  font-size: 0.82rem;
}

.metric-card strong {
  font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.metric-card.blue { box-shadow: inset 0 0 0 1px rgba(96, 165, 250, 0.15); }
.metric-card.green { box-shadow: inset 0 0 0 1px rgba(74, 222, 128, 0.18); }
.metric-card.orange { box-shadow: inset 0 0 0 1px rgba(251, 191, 36, 0.18); }
.metric-card.purple { box-shadow: inset 0 0 0 1px rgba(192, 132, 252, 0.18); }

.content-grid,
.bottom-grid {
  display: grid;
  grid-template-columns: 1.7fr 0.9fr;
  gap: 20px;
  margin-bottom: 20px;
}

.panel {
  background: rgba(10, 18, 28, 0.92);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 22px;
  padding: 22px 20px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.12);
  border: 1px solid rgba(96, 165, 250, 0.35);
  color: #cfe6ff;
  font-size: 0.72rem;
}

.chip.success {
  background: rgba(34, 197, 94, 0.12);
  border-color: rgba(74, 222, 128, 0.3);
  color: #c9f7d8;
}

.chip.neutral {
  background: rgba(148, 163, 184, 0.12);
  border-color: rgba(148, 163, 184, 0.2);
}

.blueprint-wrap {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.1);
  border-radius: 18px;
  padding: 16px;
}

.blueprint {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: #0b1322;
  min-height: 420px;
}

.blueprint svg {
  width: 100%;
  height: 100%;
  display: block;
}

.map-tag {
  position: absolute;
  transform: translate(-50%, -50%);
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
  background: rgba(11, 19, 34, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.25);
  color: white;
}

.tag-green { border-color: rgba(52, 211, 153, 0.45); }
.tag-blue { border-color: rgba(96, 165, 250, 0.38); }
.tag-orange { border-color: rgba(251, 191, 36, 0.38); }
.tag-pink { border-color: rgba(244, 114, 182, 0.4); }

.route-list,
.jobs-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.route-item,
.job-item {
  padding: 14px 12px;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.route-head,
.job-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-bottom: 6px;
}

.route-item p,
.route-item small {
  margin: 0;
  color: #bfd0ea;
}

.status {
  display: inline-flex;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 0.68rem;
  background: rgba(251, 191, 36, 0.12);
  border: 1px solid rgba(251, 191, 36, 0.25);
  color: #f7d77a;
}

.status.ok {
  background: rgba(34, 197, 94, 0.12);
  color: #b2f4c7;
  border-color: rgba(74, 222, 128, 0.18);
}

.small-line {
  height: 8px;
  margin-top: 10px;
}

.checklist {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.checklist li {
  position: relative;
  padding-left: 26px;
  color: #dfeaf7;
}

.checklist li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: #4ade80;
  font-weight: 700;
}

@media (max-width: 980px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  }

  .metrics-grid,
  .content-grid,
  .bottom-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .main-panel {
    padding: 20px 16px 30px;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .actions {
    width: 100%;
    flex-direction: column;
  }

  .primary-btn,
  .secondary-btn {
    width: 100%;
  }
}
